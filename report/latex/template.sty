\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{template}[2026/10/12 Teacher Word template layout]
\RequirePackage{fix-cm}
\RequirePackage{fontspec}
\RequirePackage{xeCJK}
\RequirePackage[paperwidth=595.3bp,paperheight=841.9bp,
  left=90bp,right=90bp,top=72bp,bottom=72bp]{geometry}
\RequirePackage{graphicx}
\RequirePackage{amsmath}
\RequirePackage{caption}
\RequirePackage{needspace}
\RequirePackage{placeins}
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage[hidelinks,bookmarksnumbered=false]{hyperref}

% 原 DOCX 的 Office 主题：中文宋体，正文西文 Calibri。
% 不用 ctex 默认标题样式；Arial 只用于原封面的 N-Puzzle。
\setmainfont{Calibri}
\setCJKmainfont{SimSun}[AutoFakeBold=1.5]
\setCJKmonofont{SimSun}[AutoFakeBold=1.5]
\newfontfamily\TemplateArial{Arial}[BoldFont={Arial Bold}]
\newfontfamily\TemplateSongLatin{SimSun}[AutoFakeBold=1.5]
\newfontfamily\TemplateCalibri{Calibri}
\definecolor{TemplateBlue}{RGB}{46,117,181}
\setlength{\parindent}{0bp}
\setlength{\parskip}{0bp}
\pagestyle{empty}
\newif\ifTemplateBody
\TemplateBodyfalse

% 绝对位置仅用于封面；正文保持可编辑的普通 LaTeX 排版。
\newcommand{\TemplateAt}[3]{%
  \node[anchor=base west,inner sep=0bp,outer sep=0bp]
    at ([xshift=#1bp,yshift=-#2bp]current page.north west) {#3};}

% ---- 封面 姓名/学号 栏：支持任意人数 ----
% 原模板固定为两行；此处按 \ReportNameOne..Five 自动输出，
% 某一对的姓名与学号都为空时该行自动跳过，因此只填两人时版面与原模板完全一致。
% 姓名栏最小宽度 24bp（与原模板空位一致，恰好容纳两个汉字）；
% 姓名更长时该栏自动加宽，其后的 学号： 标签整体右移，不会压住标签。
\newsavebox{\TemplateNameSlotBox}
\newcommand{\TemplateNameSlot}[1]{%
  \sbox{\TemplateNameSlotBox}{#1}%
  \ifdim\wd\TemplateNameSlotBox<24bp \wd\TemplateNameSlotBox=24bp\fi
  \usebox{\TemplateNameSlotBox}}
% 第 #1 行的纵坐标（bp）：原模板前两行为 614.569 与 645.769，行距 31.2bp
\newcommand{\TemplatePersonY}[1]{%
  \ifcase#1 614.569\or 645.769\or 676.969\or 708.169\or 739.369\fi}
% 一整行的内容：姓名栏 + 学号栏（整体自左向右排版，姓名变长时后面自动右移）
\newcommand{\TemplatePersonText}[2]{%
  \fontsize{12bp}{15.6bp}\selectfont 姓名：\TemplateNameSlot{#1}\hspace{12bp}学号：#2}
% 姓名与学号都为空则整行不输出
\newcommand{\TemplatePersonRow}[3]{%
  \edef\TemplateTmpName{#1}\edef\TemplateTmpId{#2}%
  \ifx\TemplateTmpName\empty
    \ifx\TemplateTmpId\empty\else
      \TemplateAt{216}{\TemplatePersonY{#3}}{\TemplatePersonText{#1}{#2}}%
    \fi
  \else
    \TemplateAt{216}{\TemplatePersonY{#3}}{\TemplatePersonText{#1}{#2}}%
  \fi}
\newcommand{\TemplateCover}{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    % 原 JPEG 为 650×328、72dpi；每边仅裁 2px。
    % 裁掉部分不放大补齐，校徽和校名的原位置、比例保持。
    \node[anchor=north west,inner sep=0bp,outer sep=0bp]
      at ([xshift=91.276431bp,yshift=-108.676098bp]current page.north west)
      {\includegraphics[trim=2bp 2bp 2bp 2bp,clip,
        width=412.287138bp,height=206.727805bp]{assets/cover-original.jpeg}};
    \TemplateAt{160.68}{407.569}{\TemplateArial\bfseries\fontsize{21.95bp}{26bp}\selectfont N-Puzzle}
    \TemplateAt{257.88}{407.45}{\xeCJKsetup{CJKglue=\hskip0.1297bp}\bfseries\fontsize{21.95bp}{26bp}\selectfont 问题求解研究报告}
    \TemplateAt{252}{552.169}{\bfseries\fontsize{12bp}{15.6bp}\selectfont 年}
    \TemplateAt{288}{552.169}{\bfseries\fontsize{12bp}{15.6bp}\selectfont 季学期}
    \draw[line width=0.84bp] ([xshift=210bp,yshift=-553.9bp]current page.north west)
      -- ([xshift=252bp,yshift=-553.9bp]current page.north west);
    \draw[line width=0.84bp] ([xshift=264bp,yshift=-553.9bp]current page.north west)
      -- ([xshift=288bp,yshift=-553.9bp]current page.north west);
    \TemplateAt{210}{552.169}{\fontsize{12bp}{15.6bp}\selectfont\ReportYear}
    \TemplateAt{264}{552.169}{\fontsize{12bp}{15.6bp}\selectfont\ReportSeason}
    \TemplatePersonRow{\ReportNameOne}{\ReportIdOne}{0}%
    \TemplatePersonRow{\ReportNameTwo}{\ReportIdTwo}{1}%
    \TemplatePersonRow{\ReportNameThree}{\ReportIdThree}{2}%
    \TemplatePersonRow{\ReportNameFour}{\ReportIdFour}{3}%
    \TemplatePersonRow{\ReportNameFive}{\ReportIdFive}{4}%
  \end{tikzpicture}%
  \null\clearpage
}

% 同原模板：三级缩进 0 / 21 / 31.44bp、10.5pt、15.6pt 网格、点引线。
% 原书签错误经用户确认修复，页码从真实正文条目生成。
\newcommand{\TemplateContents}{%
  \thispagestyle{empty}%
  \begin{tikzpicture}[remember picture,overlay]
    \node[anchor=base,inner sep=0bp,outer sep=0bp,text=TemplateBlue]
      at ([yshift=-105.407bp]current page.north west -| current page.north)
      {\fontsize{15.95bp}{20bp}\selectfont 目\hspace{24.12bp}录};
  \end{tikzpicture}%
  \vspace*{29.207bp}%
  \begingroup
  \fontsize{10.45bp}{15.6bp}\selectfont\bfseries
  \TemplateSongLatin
  \@starttoc{toc}%
  \endgroup
  \clearpage
}
\newcommand{\TemplateTOCRow}[3]{%
  \par\noindent\hspace*{#1bp}%
  \hbox to \dimexpr\linewidth-#1bp\relax{#2\nobreak\hspace{1bp}%
    \leaders\hbox to 2.6bp{\hss{\TemplateCalibri\mdseries .}\hss}\hfill
    \nobreak\hbox{\TemplateCalibri\mdseries #3}}\par
}
\newcommand{\l@templateone}{\TemplateTOCRow{0}}
\newcommand{\l@templatetwo}{\TemplateTOCRow{21}}
\newcommand{\l@templatethree}{\TemplateTOCRow{31.44}}
% 原4.1条目占两行；清除错误文字后仍保留第二行高度。
\newcommand{\l@templatetwoextra}[2]{\TemplateTOCRow{21}{#1}{#2}\vspace{15.6bp}}
\setcounter{tocdepth}{3}
\def\toclevel@templateone{0}
\def\toclevel@templatetwo{1}
\def\toclevel@templatethree{2}
\def\toclevel@templatetwoextra{1}
\pdfstringdefDisableCommands{\def\quad{ }\def\color#1{}}

\newcommand{\TemplateBeginBody}{%
  \TemplateBodytrue\setcounter{page}{1}\null%
  \fontsize{10.5bp}{15.6bp}\selectfont
}
\AddToHook{shipout/foreground}{%
  \ifTemplateBody
    \begin{tikzpicture}[remember picture,overlay]
      \node[anchor=base,inner sep=0bp,outer sep=0bp]
        at ([yshift=-790.13bp]current page.north west -| current page.north)
        {\fontsize{9bp}{11bp}\selectfont\thepage};
    \end{tikzpicture}%
  \fi
}

% 文字取自原目录，不自动重排编号，不修正原有用词。
% 原正文为空白页：只登记不可见的章节占位，不新增可见标题或页。
% 在 body.tex 的对应占位后填写正文，目录会指向填写内容所在页。
\newcommand{\TemplateSection}[1]{%
  \phantomsection
  \addcontentsline{toc}{templateone}{#1}%
}
\newcommand{\TemplateSubsection}[2][templatetwo]{%
  \phantomsection
  \addcontentsline{toc}{#1}{#2}%
}
\newcommand{\TemplateSubsubsection}[1]{%
  \phantomsection
  \addcontentsline{toc}{templatethree}{#1}%
}
